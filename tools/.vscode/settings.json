{
    "workbench.colorTheme": "Default Dark+",
    "workbench.editor.enablePreview": false,
    "editor.minimap.enabled": false,
    "editor.tabSize": 4,
    "editor.fontSize": 16,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.fontFamily": "'Source Code Pro'",
    "files.autoSave": "afterDelay",
    "dart.previewFlutterUiGuides": true,
    "dart.lineLength": 150,
    "[dart]": {
        "editor.rulers": [
            150
        ],
    },
    "cSpell.words": [
        "bordercolor",
        "borderopacity",
        "dasharray",
        "deskcolor",
        "docname",
        "empcolor",
        "empopacity",
        "empspacing",
        "groupmode",
        "linecap",
        "linejoin",
        "namedview",
        "nodetypes",
        "originx",
        "originy",
        "pagecheckerboard",
        "pagecolor",
        "pageopacity",
        "showborder",
        "showgrid",
        "showpageshadow",
        "spacingx",
        "spacingy",
        "xdpi",
        "ydpi"
    ]
}